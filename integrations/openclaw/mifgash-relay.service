# Mifgash relay as a systemd --user unit.
# Copy relay.py to ~/.mifgash/relay.py and this file to ~/.config/systemd/user/mifgash-relay.service, put the token in ~/.mifgash/relay.env
# (one line: MIFGASH_HOOK_TOKEN=<the gateway hooks.token>, chmod 600), then:
#   systemctl --user daemon-reload && systemctl --user enable --now mifgash-relay
#   journalctl --user -u mifgash-relay -f
[Unit]
Description=Mifgash relay (events -> local OpenClaw hook)
After=network-online.target

[Service]
EnvironmentFile=%h/.mifgash/relay.env
Environment=MIFGASH_URL=https://mifgash.sveder.com
Environment=MIFGASH_HOOK_URL=http://127.0.0.1:18789/hooks/wake
ExecStart=/usr/bin/python3 %h/.mifgash/relay.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
