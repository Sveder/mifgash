# Settings for "docker compose up". Copy to .env only if you want to change a value:
#   cp .env.example .env
# Every value here is a default. No real secret is needed: the containers make random keys
# on the first start and keep them in the "keys" volume.

# Host port for the site: http://localhost:8000/
MIFGASH_PORT=8000

# LLM backend: stub = keyword parser, no network, no key (default).
# meta = Muse Spark Open on Baseten (needs BASETEN_API_KEY). claude = the local `claude -p` CLI (not in the image).
MIFGASH_LLM_BACKEND=stub
BASETEN_API_KEY=

# Database (the db service). Change the password if the port is reachable from other machines.
MIFGASH_DB_NAME=mifgash
MIFGASH_DB_USER=mifgash
MIFGASH_DB_PASSWORD=mifgash-local-only

# Plain http on localhost: DEBUG stays off, HTTPS cookies stay off.
MIFGASH_DEBUG=0
MIFGASH_HTTPS=0
MIFGASH_ALLOWED_HOSTS=localhost,127.0.0.1
MIFGASH_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MIFGASH_PUBLIC_URL=http://localhost:8000

# Demo-world endpoints for the scripts in demo/ (needs MIFGASH_DEMO_TOKEN too). The Demo button on
# the home page works without it. Keep 0 on any host that other people can reach.
MIFGASH_DEMO=0
MIFGASH_DEMO_TOKEN=

# Email: stub writes mail to the log, sends nothing.
MIFGASH_EMAIL=stub

# Optional fixed keys. Empty = random keys made on the first start.
MIFGASH_SECRET_KEY=
MIFGASH_FIELD_KEYS=
MIFGASH_HASH_KEY=
